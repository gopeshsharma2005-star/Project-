# 1. Import libraries
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score


# 2. Load dataset

df = pd.read_csv(r"C:\Users\gopes\Downloads\mlr.csv")

print("Dataset:")
print(df.head())


# 3. Check dataset information

print("\nDataset Shape:")
print(df.shape)

print("\nDataset Information:")
print(df.info())

print("\nMissing Values:")
print(df.isnull().sum())


# 4. Separate Independent and Dependent Variables

# X = Independent variables / Features
X = df.drop("Profit", axis=1)

# y = Dependent variable / Target
y = df["Profit"]


# 5. Define categorical and numerical columns

categorical_features = ["State"]

numeric_features = [
    "R&D Spend",
    "Administration",
    "Marketing Spend"
]


# 6. Encode categorical variable

preprocessor = ColumnTransformer(
    transformers=[
        (
            "categorical",
            OneHotEncoder(drop="first", handle_unknown="ignore"),
            categorical_features
        )
    ],
    remainder="passthrough"
)


# 7. Split dataset into training and testing

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("\nTraining data:", X_train.shape)
print("Testing data:", X_test.shape)


# 8. Apply encoding

X_train = preprocessor.fit_transform(X_train)

X_test = preprocessor.transform(X_test)


# 9. Create Linear Regression model

model = LinearRegression()


# 10. Train the model

model.fit(X_train, y_train)


# 11. Predict Profit on test data

y_pred = model.predict(X_test)


# 12. Compare Actual vs Predicted Profit


comparison = pd.DataFrame({
    "Actual Profit": y_test.values,
    "Predicted Profit": y_pred
})

print("\nActual vs Predicted Profit:")
print(comparison)


# 13. Evaluate the model


mae = mean_absolute_error(y_test, y_pred)

mse = mean_squared_error(y_test, y_pred)

rmse = np.sqrt(mse)

r2 = r2_score(y_test, y_pred)



print("MODEL PERFORMANCE")

print("MAE  :", mae)
print("MSE  :", mse)
print("RMSE :", rmse)
print("R2   :", r2)


# 14. Display model coefficients


feature_names = preprocessor.get_feature_names_out()

coefficients = pd.DataFrame({
    "Feature": feature_names,
    "Coefficient": model.coef_
})

print("MODEL COEFFICIENTS")

print(coefficients)


# 15. PREDICT PROFIT FOR A NEW COMPANY

# Enter the new company's information here

new_company = pd.DataFrame({
    "R&D Spend": [140000],
    "Administration": [100000],
    "Marketing Spend": [150000],
    "State": ["Florida"]
})


# Transform new company data
new_company_transformed = preprocessor.transform(new_company)


# Predict Profit
predicted_profit = model.predict(new_company_transformed)


# Display prediction
print("PROFIT PREDICTION")

print("Predicted Profit:", predicted_profit[0])
